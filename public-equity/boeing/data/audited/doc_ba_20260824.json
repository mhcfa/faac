      "rows": [
        {
          "id": "max_debt_to_total_capital",
          "label": "Maximum Consolidated Debt / Total Capital",
          "cells": {
            "covenant_topic": {
              "value": "Financial Leverage Covenant"
            },
            "disclosure": {
              "value": "Restricts consolidated debt (as defined in the credit agreements) to not exceed 60% of Boeing's total capital (as defined in the agreements)."
            }
          }
        },
        {
          "id": "minimum_liquidity",
          "label": "Minimum Liquidity Covenant",
          "cells": {
            "covenant_topic": {
              "value": "Minimum Liquidity Covenant"
            },
            "disclosure": {
              "value": "Requires Boeing to maintain liquidity (as defined in each agreement) of at least $5.0 billion; included in the new 364-Day Credit Agreement and added on August 24, 2026 via Amendment No. 1 to both the 2023 and 2024 Five-Year Credit Agreements."
            }
          }
        },
        {
          "id": "sofr_pricing_margin",
          "label": "SOFR Borrowing Margin and Base Rate",
          "cells": {
            "covenant_topic": {
              "value": "Interest Rate & Pricing Grid"
            },
            "disclosure": {
              "value": "364-Day Credit Agreement SOFR borrowings bear interest at Term SOFR + 1.250% to 1.700% (125 to 170 bps) per annum depending on Boeing's credit rating. Non-SOFR borrowings bear interest at highest of (1) Citibank base rate, (2) Federal Funds rate + 0.50%, or (3) 1-month Term SOFR + 1.00%, plus 0.250% to 0.700% depending on credit rating."
            }
          }
        },
        {
          "id": "commitment_fee",
          "label": "Undrawn Commitment Fee",
          "cells": {
            "covenant_topic": {
              "value": "Commitment Fee"
            },
            "disclosure": {
              "value": "0.125% to 0.300% (12.5 to 30.0 bps) per annum on aggregate commitments under the 364-Day Credit Agreement, depending on Boeing's credit rating."
            }
          }
        },
        {
          "id": "maturity_schedule",
          "label": "Facility Maturity Schedule",
          "cells": {
            "covenant_topic": {
              "value": "Maturity Dates & Extension Options"
            },
            "disclosure": {
              "value": "364-Day Credit Agreement ($3.0B): terminates Aug 23, 2027 (with 1-year term-out option and 364-day extension request right). 2023 Five-Year Credit Agreement ($3.0B): extended 365 days to Aug 24, 2029. 2024 Five-Year Credit Agreement ($4.0B): extended 365 days to May 15, 2030."
            }
          }
        },
        {
          "id": "negative_covenants_and_eod",
          "label": "Negative Covenants and Events of Default",
          "cells": {
            "covenant_topic": {
              "value": "Negative Covenants & Events of Default"
            },
            "disclosure": {
              "value": "Customary restrictions on liens and mergers/consolidations. Events of default include: (1) 5-business-day payment default on principal/interest, (2) materially incorrect representation/warranty, (3) 30-day uncured covenant breach after notice, (4) certain debt cross-defaults, (5) specified ERISA liabilities, and (6) bankruptcy/insolvency."
            }
          }
        }
